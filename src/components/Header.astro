---
import { site } from '../data/site';
const links = [
  { href: '/#apps', label: 'Apps' },
  { href: '/#design', label: 'Design & art' },
  { href: '/#web', label: 'Web' },
  { href: '/#about', label: 'About' },
];
---
<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="logo" aria-label={`${site.name}, home`}>
      <img class="logo__img" src="/images/logo.png" alt="" width="36" height="36" />
      <span class="logo__name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--solid header__cta" href="/#contact">Contact</a>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner { display: flex; align-items: center; gap: 1.5rem; height: 4.25rem; }

  .logo {
    display: flex; align-items: center; gap: .65rem;
    flex-shrink: 0;                 /* the logo block never gets squeezed */
    text-decoration: none; font-weight: 600; white-space: nowrap;
  }
  .logo__img {
    width: 2.25rem; height: 2.25rem;
    flex-shrink: 0;                 /* keeps the flower perfectly round */
    object-fit: contain; display: block;
  }

  nav { margin-left: auto; }
  nav ul { display: flex; gap: .25rem; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block; padding: .5rem .8rem; border-radius: 999px; text-decoration: none;
    font-size: var(--step--1); color: var(--muted);
    white-space: nowrap;            /* "Design & art" stays on one line */
  }
  nav a:hover { color: var(--ink); background: var(--surface); }
  .header__cta { padding: .55rem 1rem; flex-shrink: 0; }

  /* Tablets and phones: two rows.
     Row 1: logo + name on the left, Contact on the right.
     Row 2: the menu links. */
  @media (max-width: 760px) {
    .header__inner { flex-wrap: wrap; height: auto; row-gap: .35rem; column-gap: 1rem; padding-block: .7rem .45rem; }
    .header__cta { margin-left: auto; padding: .45rem .9rem; font-size: var(--step--1); }
    nav {
      order: 3; width: 100%; margin-left: 0;
      overflow-x: auto; scrollbar-width: none;   /* scrolls sideways if a screen is extra narrow */
    }
    nav::-webkit-scrollbar { display: none; }
    nav ul { gap: .15rem; margin-inline: -.6rem; }  /* lines the first link up with the logo */
    nav a { padding: .45rem .6rem; }

    /* the header is taller now, so menu links don't hide section titles under it */
    :global(html) { scroll-padding-top: 7.5rem; }
  }

  /* Very small phones: hide the Contact button so the name always fits */
  @media (max-width: 360px) {
    .header__cta { display: none; }
  }
</style>