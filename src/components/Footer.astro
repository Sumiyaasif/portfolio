---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__inner">
    <p>© {year} {site.name}</p>
    <ul>
      {site.socials.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: 2rem; font-size: var(--step--1); color: var(--muted); }
  .footer__inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  a { text-decoration: none; }
  a:hover { color: var(--ink); }
</style>
