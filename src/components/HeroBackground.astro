---
// Interactive background for the hero: a grid of dots that swell and drift away from the
// cursor, plus a soft colored glow that follows it. Plain JS + <canvas>, no libraries.
// Runs only while the hero is on screen; static for "reduce motion" users.
---
<div class="hbg" aria-hidden="true">
  <div class="hbg__glow"></div>
  <canvas class="hbg__dots"></canvas>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.hbg');
  const hero = root?.parentElement;
  const canvas = root?.querySelector('canvas');
  const glow = root?.querySelector<HTMLElement>('.hbg__glow');

  if (root && hero && canvas && glow) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = matchMedia('(pointer: fine)').matches;
    const css = getComputedStyle(document.documentElement);
    const ink = css.getPropertyValue('--ink').trim() || '#16181d';
    const accent = css.getPropertyValue('--accent').trim() || '#3d2fd6';

    const GAP = 30, RADIUS = 160;
    let w = 0, h = 0, dpr = 1;
    let dots: { x: number; y: number }[] = [];
    const mouse = { x: -9999, y: -9999, tx: -9999, ty: -9999 };
    let running = false, t = 0;

    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = hero.clientWidth; h = hero.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      dots = [];
      for (let y = GAP / 2; y < h; y += GAP) for (let x = GAP / 2; x < w; x += GAP) dots.push({ x, y });
      draw();
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const d of dots) {
        const dx = d.x - mouse.x, dy = d.y - mouse.y;
        const dist = Math.hypot(dx, dy);
        const k = Math.max(0, 1 - dist / RADIUS); // 0 far → 1 at cursor
        const push = k * k * 14;
        const x = d.x + (dist ? (dx / dist) * push : 0);
        const y = d.y + (dist ? (dy / dist) * push : 0);
        ctx.globalAlpha = 0.16 + k * 0.7;
        ctx.fillStyle = k > 0.05 ? accent : ink;
        ctx.beginPath();
        ctx.arc(x, y, 1.2 + k * 2.4, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const tick = () => {
      if (!running) return;
      t += 0.004;
      if (!finePointer) {
        // touch devices: let the glow drift slowly on its own
        mouse.tx = w * (0.6 + Math.cos(t) * 0.25);
        mouse.ty = h * (0.45 + Math.sin(t * 1.3) * 0.25);
      }
      mouse.x += (mouse.tx - mouse.x) * 0.12;
      mouse.y += (mouse.ty - mouse.y) * 0.12;
      glow.style.transform = `translate3d(${mouse.x}px, ${mouse.y}px, 0)`;
      draw();
      requestAnimationFrame(tick);
    };

    resize();
    addEventListener('resize', resize);

    if (!reduce) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        mouse.tx = e.clientX - r.left; mouse.ty = e.clientY - r.top;
        if (mouse.x < -999) { mouse.x = mouse.tx; mouse.y = mouse.ty; }
        root.classList.add('is-active');
      });
      hero.addEventListener('pointerleave', () => { mouse.tx = mouse.ty = -9999; root.classList.remove('is-active'); });
      if (!finePointer) root.classList.add('is-active');

      new IntersectionObserver(([entry]) => {
        running = entry.isIntersecting;
        if (running) requestAnimationFrame(tick);
      }).observe(hero);
    }
  }
</script>

<style>
  .hbg { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .hbg__dots { position: absolute; inset: 0; mask-image: linear-gradient(to bottom, #000 70%, transparent); -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent); }
  .hbg__glow {
    position: absolute; left: 0; top: 0; width: 520px; height: 520px; margin: -260px 0 0 -260px;
    border-radius: 50%; filter: blur(70px); opacity: 0; transition: opacity .6s ease;
    background: radial-gradient(circle at 40% 40%, color-mix(in srgb, var(--accent) 38%, transparent), transparent 62%),
                radial-gradient(circle at 65% 65%, color-mix(in srgb, #0f7b62 30%, transparent), transparent 60%);
  }
  .hbg.is-active .hbg__glow { opacity: 1; }
</style>
